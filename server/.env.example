# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/todo?schema=public"

# Secret used to sign session JWTs. Use a long random string in production.
JWT_SECRET="replace-me-with-a-long-random-string"

PORT=4000
# Origins allowed to call the API with credentials. The client is a separate
# origin now that the Vite proxy is gone, so this has to be exact — scheme,
# host and port, no trailing slash. Comma-separate to allow more than one.
#   local   CLIENT_ORIGIN="http://localhost:5173"
#   Render  CLIENT_ORIGIN="https://myowntask.onrender.com"
CLIENT_ORIGIN="http://localhost:5173"

# Set this to production on Render. It also switches the session cookie to
# SameSite=None + Secure, without which the browser drops it on a cross-site
# request and every call comes back 401.
NODE_ENV=development

# Base URL that password reset links point at. Defaults to CLIENT_ORIGIN.
APP_URL="http://localhost:5173"
# How long a reset link stays valid.
RESET_TOKEN_MINUTES=30

# EmailJS, used to deliver password reset emails.
# Enable "Allow EmailJS API for non-browser applications" under
# Account -> Security, or server-side sends are rejected.
# Leave blank in development: the reset link is logged to the console instead.
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""

# Self-ping cron: keeps the instance warm and sweeps expired reset tokens.
# Set to 0 to turn it off.
CRON_HEALTH_PING_MS=300000
SELF_URL="http://127.0.0.1:4000"
