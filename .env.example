# Base URL of the Express API. Baked in at build time, so it must be set
# BEFORE `npm run build` — on Render, add it to the static site's environment.
#
#   local   VITE_API_URL=http://localhost:4000   (already in .env.development)
#   Render  VITE_API_URL=https://<your-api>.onrender.com
#
# Leave it empty ONLY if something in front of the static host rewrites /api to
# the server; otherwise the built site has no way to reach the API.
VITE_API_URL=
